{
  "name": "vivid-edit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ブラウザだけで完結するショート動画（縦型）専用のビデオエディタ",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:model": "node --import ./scripts/ts-resolve-register.mjs scripts/model-selftest.mjs",
    "bundle": "npm run build && npm run lab:build && node scripts/sync-bundles.mjs",
    "lab": "vite lab/auto-cut",
    "lab:build": "vite build lab/auto-cut",
    "lab:typecheck": "tsc -p lab/auto-cut --pretty false && tsc -p lab/scene-cut --pretty false && tsc -p lab/beat --pretty false && tsc -p lab/thumbnail --pretty false && tsc -p lab/reframe --pretty false && tsc -p lab/export-cost --pretty false && tsc -p lab/keyframe --pretty false && tsc -p lab/project-pack --pretty false",
    "lab:test": "node lab/auto-cut/selftest.mjs && node lab/scene-cut/selftest.mjs && node lab/beat/selftest.mjs && node lab/thumbnail/selftest.mjs && node lab/reframe/selftest.mjs && node lab/export-cost/selftest.mjs && node lab/keyframe/selftest.mjs && node lab/project-pack/selftest.mjs",
    "lab:fixtures": "node lab/fixtures/make-audio.mjs",
    "lab:bench": "node lab/auto-cut/bench.mjs",
    "lab:loudness": "node lab/auto-cut/loudness.mjs",
    "lab:clipmatch": "node lab/auto-cut/clipmatch.mjs",
    "lab:uitest": "node lab/auto-cut/uitest.mjs && node lab/beat/uitest.mjs && node lab/scene-cut/uitest.mjs && node lab/thumbnail/uitest.mjs && node lab/reframe/uitest.mjs && node lab/keyframe/uitest.mjs",
    "lab:probe": "node lab/auto-cut/probe.mjs",
    "lab:frames": "node lab/fixtures/make-frames.mjs",
    "lab:scene": "node lab/scene-cut/bench.mjs",
    "lab:scene:probe": "node lab/scene-cut/probe.mjs",
    "lab:scene:portrait": "LAB_ASPECT=portrait node lab/scene-cut/bench.mjs",
    "lab:scene:probe:portrait": "LAB_ASPECT=portrait node lab/scene-cut/probe.mjs",
    "lab:scene:native": "LAB_ASPECT=native node lab/scene-cut/bench.mjs",
    "lab:scene:probe:native": "LAB_ASPECT=native node lab/scene-cut/probe.mjs",
    "lab:scene:captions": "LAB_CAPTIONS=0.26 node lab/scene-cut/bench.mjs",
    "lab:scene:caption-probe": "node lab/scene-cut/caption-probe.mjs",
    "lab:scene:outline-probe": "node lab/scene-cut/outline-probe.mjs",
    "lab:scene:demo": "vite lab/scene-cut",
    "lab:scene:uitest": "node lab/scene-cut/uitest.mjs",
    "lab:beats-fixtures": "node lab/fixtures/make-beats.mjs",
    "lab:beat": "node lab/beat/bench.mjs",
    "lab:beat:demo": "vite lab/beat",
    "lab:beat:uitest": "node lab/beat/uitest.mjs",
    "lab:beat:probe": "node lab/beat/probe.mjs",
    "lab:thumb": "node lab/thumbnail/bench.mjs",
    "lab:thumb:probe": "node lab/thumbnail/probe.mjs",
    "lab:thumb:portrait": "LAB_ASPECT=portrait node lab/thumbnail/bench.mjs",
    "lab:thumb:native": "LAB_ASPECT=native node lab/thumbnail/bench.mjs",
    "lab:thumb:demo": "vite lab/thumbnail",
    "lab:thumb:uitest": "node lab/thumbnail/uitest.mjs",
    "lab:thumb:format": "node lab/thumbnail/format-probe.mjs",
    "lab:thumb:outline": "node lab/thumbnail/outline-format-probe.mjs",
    "lab:reframe": "node lab/reframe/bench.mjs",
    "lab:reframe:probe": "node lab/reframe/probe.mjs",
    "lab:reframe:demo": "vite lab/reframe",
    "lab:reframe:uitest": "node lab/reframe/uitest.mjs && node lab/keyframe/uitest.mjs",
    "lab:reframe:decimate": "node lab/reframe/decimate-probe.mjs",
    "lab:reframe:gate": "node lab/reframe/gate-probe.mjs",
    "lab:export": "node lab/export-cost/bench.mjs",
    "lab:keyframe": "node lab/keyframe/bench.mjs",
    "lab:keyframe:probe": "node lab/keyframe/probe.mjs",
    "lab:keyframe:hold": "node lab/keyframe/hold-probe.mjs",
    "lab:keyframe:demo": "vite lab/keyframe",
    "lab:keyframe:uitest": "node lab/keyframe/uitest.mjs",
    "lab:export:audio": "node lab/export-cost/audio.mjs",
    "lab:pack": "node lab/project-pack/bench.mjs",
    "lab:pack:thumbsize": "node lab/project-pack/thumb-size.mjs",
    "lab:pack:thumbs": "node lab/project-pack/thumb-probe.mjs",
    "lab:pack:digest": "node lab/project-pack/digest-probe.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "mediabunny": "^1.55.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
